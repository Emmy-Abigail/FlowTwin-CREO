# Copia este archivo como .env y pon una contraseña propia.
# SQL Server exige al menos 8 caracteres con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=CambiaEsta#2026

# Administrador del broker Mosquitto (ADR-24): la usa la API para crear las cuentas de los nodos.
# Genera una con: openssl rand -base64 33 | tr -d '/+=' | head -c 40
# La misma va en los user-secrets de la API: dotnet user-secrets set "Mqtt:ClaveAdmin" "..."
MQTT_ADMIN_CLAVE=CambiaEsta
