{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "//": "ConnectionStrings:FlowTwin y Jwt:Clave van en dotnet user-secrets (desarrollo) o en variables de entorno (servidor), nunca aquí.",
  "ConnectionStrings": {
    "FlowTwin": ""
  },

  "Jwt": {
    "Emisor": "flowtwin",
    "Clave": "",
    "MinutosAcceso": 15,
    "MinutosInactividad": 30,
    "HorasSesion": 12
  },

  "Contrasenas": {
    "HistorialNoRepetir": 3,
    "MinutosBloqueo": 15,
    "HorasTemporal": 24,
    "ExigirCambioPrimerIngreso": false
  },

  "//AdminInicial": "Si no hay ningún Administrador activo, la API crea este al arrancar. ClaveTemporal va en user-secrets o en una variable de entorno.",
  "AdminInicial": {
    "Correo": "",
    "Nombres": "Administrador",
    "Apellidos": "CREO+",
    "ClaveTemporal": ""
  },

  "LimitePeticiones": {
    "AuthPorMinuto": 20
  },

  "//Mqtt": "Broker Mosquitto de los nodos (ADR-24). La clave del administrador (Mqtt:ClaveAdmin) va en user-secrets o en la variable Mqtt__ClaveAdmin, nunca aquí. En la clínica: UsarTls true y puerto 8883.",
  "Mqtt": {
    "Activo": true,
    "Servidor": "localhost",
    "Puerto": 1883,
    "UsarTls": false,
    "Prefijo": "flowtwin",
    "UsuarioAdmin": "flowtwin-admin",
    "MensajesPorMinutoPorNodo": 300
  },

  "//Presencia": "Parámetros del motor de presencia y de los nodos. Los ajusta el equipo técnico en la instalación.",
  "Presencia": {
    "RssiMinimo": -80,
    "VentanaSegundos": 10,
    "HisteresisSegundos": 45,
    "SinLecturaSalidaSegundos": 120,
    "IntervaloMs": 1000,
    "MotorActivo": true,
    "LatidoMaximoSegundos": 120,
    "RevisionLatidosSegundos": 30
  },

  "//Jornada": "Cierre de jornada (RN-08, ADR-25). La hora se configura en Configuración › Parámetros (ADR-27); aquí solo se puede apagar (las pruebas lo apagan).",
  // Bitácora (P11). La clave del sello de integridad NUNCA va aquí: user-secrets (Auditoria:ClaveSello) o la variable
  // de entorno Auditoria__ClaveSello, en base64 y con al menos 32 bytes (openssl rand -base64 48).
  "Auditoria": {
    "SelladoActivo": true,
    "MargenSelloSegundos": 60
  },

  "Jornada": {
    "CierreActivo": true
  },

  "Ingesta": {
    "MaxLecturasPorLote": 200,
    "EdadMaximaMs": 600000,
    "RetencionLecturasDias": 7,
    "HoraPurga": 3
  },

  "ZonaHoraria": "America/Lima",

  "//Demo": "Temporal (ADR-22): botón Simulación para presentar el sistema sin nodos. En la clínica siempre false.",
  "Demo": {
    "SimulacionDisponible": false
  },

  "BaseDatos": {
    "MigrarAlIniciar": false,
    "SembrarDemo": false
  },

  // Maquetas 3D por piso (ADR-28): carpeta fuera del repositorio con piso-{id}/maqueta.glb, ambientes.json y zonas.json.
  // Relativa a la raíz de la API o absoluta. Vacía = ningún piso tiene maqueta.
  "Maquetas": {
    "Ruta": ""
  }
}
