{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "//": "ConnectionStrings:FlowTwin y Jwt:Clave van en dotnet user-secrets (desarrollo) o en variables de entorno (servidor), nunca aquí.",
  "ConnectionStrings": {
    "FlowTwin": ""
  },

  "Jwt": {
    "Emisor": "flowtwin",
    "Clave": "",
    "MinutosAcceso": 15,
    "MinutosInactividad": 30,
    "HorasSesion": 12
  },

  "Contrasenas": {
    "HistorialNoRepetir": 3,
    "MinutosBloqueo": 15,
    "HorasTemporal": 24,
    "ExigirCambioPrimerIngreso": false
  },

  "//AdminInicial": "Si no hay ningún Administrador activo, la API crea este al arrancar. ClaveTemporal va en user-secrets o en una variable de entorno.",
  "AdminInicial": {
    "Correo": "",
    "Nombres": "Administrador",
    "Apellidos": "CREO+",
    "ClaveTemporal": ""
  },

  "LimitePeticiones": {
    "AuthPorMinuto": 20,
    "IngestaPorMinuto": 600
  },

  "//Presencia": "Parámetros del motor de presencia y de los nodos. Los ajusta el equipo técnico en la instalación.",
  "Presencia": {
    "RssiMinimo": -80,
    "VentanaSegundos": 10,
    "HisteresisSegundos": 45,
    "SinLecturaSalidaSegundos": 120,
    "IntervaloMs": 1000,
    "MotorActivo": true,
    "LatidoMaximoSegundos": 120,
    "RevisionLatidosSegundos": 30
  },

  "Ingesta": {
    "MaxLecturasPorLote": 200,
    "EdadMaximaMs": 600000,
    "RetencionLecturasDias": 7,
    "HoraPurga": 3
  },

  "ZonaHoraria": "America/Lima",

  "//Demo": "Temporal (ADR-22): botón Simulación para presentar el sistema sin nodos. En la clínica siempre false.",
  "Demo": {
    "SimulacionDisponible": false
  },

  "BaseDatos": {
    "MigrarAlIniciar": false,
    "SembrarDemo": false
  }
}
