{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "//": "ConnectionStrings:FlowTwin y Jwt:Clave van en dotnet user-secrets (desarrollo) o en variables de entorno (servidor), nunca aquí.",
  "ConnectionStrings": {
    "FlowTwin": ""
  },

  "Jwt": {
    "Emisor": "flowtwin",
    "Clave": "",
    "MinutosAcceso": 15,
    "MinutosInactividad": 30,
    "HorasSesion": 12
  },

  "Contrasenas": {
    "HistorialNoRepetir": 3,
    "MinutosBloqueo": 15,
    "HorasTemporal": 24,
    "ExigirCambioPrimerIngreso": false
  },

  "//AdminInicial": "Si no hay ningún Administrador activo, la API crea este al arrancar. ClaveTemporal va en user-secrets o en una variable de entorno.",
  "AdminInicial": {
    "Correo": "",
    "Nombres": "Administrador",
    "Apellidos": "CREO+",
    "ClaveTemporal": ""
  },

  "LimitePeticiones": {
    "AuthPorMinuto": 20
  },

  "ZonaHoraria": "America/Lima",

  "BaseDatos": {
    "MigrarAlIniciar": false,
    "SembrarDemo": false
  }
}
